# =================================================================
# Nasio 环境变量配置模板
# 复制此文件为 .env 并按需调整参数: cp .env.example .env
# =================================================================

# 1. 访问安全令牌 (Bearer Token)
# 用于 MCP 智能体访问验证及客户端连接凭证，建议使用高强度随机字符串
MCP_AUTH_TOKEN=your_secure_random_token_here

# 2. 系统权限对齐 (对齐宿主机 NAS 账号，避免读写权限冲突)
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# 3. 宿主机实际存储与媒体挂载目录 (按实际 NAS 路径修改)
DOWNLOAD_DIR=/volume1/Download
MEDIA_DIR=/volume1/Media
TRASH_DIR=/volume1/.trash

# 4. 持久化数据存储目录 (默认为当前工程 ./data 下)
NASIO_DATA_DIR=./data/server
QBITTORRENT_CONFIG_DIR=./data/qbittorrent

# 5. 外部映射端口
NASIO_PORT=8000
QBITTORRENT_WEB_PORT=8085
QBITTORRENT_BT_PORT=6881
WEB_PORT=8086
